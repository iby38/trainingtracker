{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker name you choose in the Cloudflare dashboard.
  "name": "liftlog",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Any unknown path loads the app instead of a 404.
    "not_found_handling": "single-page-application",
    // Only /api/* runs Worker code; every other file is served straight from the edge.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }

  // ---- Later, when adding the backend database (see README) ----
  // ,"d1_databases": [
  //   { "binding": "DB", "database_name": "liftlog", "database_id": "PASTE-ID-HERE" }
  // ]
}
